// Shigo data model. Postgres everywhere (Neon on Vercel; pull the same URL locally with `vercel env pull`).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Seller {
  id             String        @id @default(cuid())
  phone          String        @unique
  name           String
  bankName       String?
  bankCode       String? // NIP bank code from the picker (src/lib/banks.json)
  accountNumber  String?
  accountName    String? // the name on the account, as the bank returned it
  verifiedAt     DateTime? // set when the bank confirmed the account and the name tallied
  // How the rail names this receiving account in webhook payloads (Paystack DVA number, Ecobank account number).
  railAccountRef String?       @unique
  createdAt      DateTime      @default(now())
  orders         Order[]
  credits        Credit[]
  ledger         LedgerEntry[]
  reports        Report[]
  devices        Device[]
  alerts         BankAlert[]
}

// One order = one expected payment. State machine: PENDING -> PAID, or PENDING -> CANCELLED.
model Order {
  id          String       @id @default(cuid())
  sellerId    String
  seller      Seller       @relation(fields: [sellerId], references: [id])
  amountKobo  Int
  reference   String       @unique // internal order id shown to the seller; buyers are never asked to type it
  buyerName   String? // who the seller expects to pay; matched against the sender name on the bank credit
  note        String?
  state       String       @default("PENDING")
  createdAt   DateTime     @default(now())
  paidAt      DateTime?
  credit      Credit?
  ledgerEntry LedgerEntry?
  reports     Report[]

  @@index([sellerId, state, amountKobo])
}

// One inbound payment as the rail reported it; state MATCHED, HELD (seller picks) or UNMATCHED.
model Credit {
  id         String   @id @default(cuid())
  sellerId   String?
  seller     Seller?  @relation(fields: [sellerId], references: [id])
  rail       String // "paystack" | "ecobank" | "bankapp" | "simulated"
  externalId String // the rail's own id for this transaction; (rail, externalId) is the idempotency key
  amountKobo Int
  narration  String?
  payerName  String?
  occurredAt DateTime
  raw        String // full payload as received, for audit
  state      String   @default("UNMATCHED")
  orderId    String?  @unique
  order      Order?   @relation(fields: [orderId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([rail, externalId])
  @@index([sellerId, state])
}

// One row per confirmed payment. This is the record the seller exports.
model LedgerEntry {
  id         String   @id @default(cuid())
  sellerId   String
  seller     Seller   @relation(fields: [sellerId], references: [id])
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id])
  amountKobo Int
  date       DateTime

  @@index([sellerId, date])
}

// Seller's own record of a fake-alert attempt; never shared with other sellers.
model Report {
  id           String    @id @default(cuid())
  sellerId     String
  seller       Seller    @relation(fields: [sellerId], references: [id])
  orderId      String?
  order        Order?    @relation(fields: [orderId], references: [id])
  note         String?
  imageDataUrl String? // the screenshot the seller was shown, kept only for their own report
  createdAt    DateTime  @default(now())
  sentToBankAt DateTime?
}

// One-time sign-in code. Only a hash is stored; the pending sign-in details ride along until the code is confirmed.
model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  payload   String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

// Recent bank-name lookups, shared by every server instance so one sign-in spends one lookup.
model BankLookup {
  key       String   @id // "<bankCode>:<accountNumber>"
  found     Boolean
  name      String?
  message   String?
  createdAt DateTime @default(now())
}

// A phone running the Shigo Android app, allowed to send bank-app alerts for one seller. Only a hash of its key is stored.
model Device {
  id         String      @id @default(cuid())
  sellerId   String
  seller     Seller      @relation(fields: [sellerId], references: [id])
  keyHash    String      @unique
  label      String? // phone model, so the seller can tell their phones apart
  createdAt  DateTime    @default(now())
  lastSeenAt DateTime?
  revokedAt  DateTime?
  alerts     BankAlert[]

  @@index([sellerId])
}

// Every alert a phone sent from an allowed bank app, read or not, so the seller can see exactly what Shigo saw.
// status: "credit" (matched like any bank credit), "check" (money in, held for the seller), "unclear", "not_credit", "stale".
model BankAlert {
  id          String   @id @default(cuid())
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id])
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id])
  app         String // Android package name, e.g. team.opay.pay
  title       String?
  text        String
  postedAt    DateTime // when the bank app posted it, moved onto the server clock
  fingerprint String // hash of app, post time and text; the same alert sent twice is stored once
  status      String
  reason      String?
  amountKobo  Int?
  payerName   String?
  creditId    String?
  createdAt   DateTime @default(now())

  @@unique([sellerId, fingerprint])
  @@index([sellerId, createdAt])
}
