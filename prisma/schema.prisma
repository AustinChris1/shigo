// Shigo data model. Postgres everywhere (Neon on Vercel; pull the same URL locally with `vercel env pull`).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Seller {
  id             String        @id @default(cuid())
  phone          String        @unique
  name           String
  bankName       String?
  bankCode       String? // NIP bank code from the picker (src/lib/banks.json)
  accountNumber  String?
  accountName    String? // the name on the account, as the bank returned it
  verifiedAt     DateTime? // set when the bank confirmed the account and the name tallied
  // How the rail names this receiving account in webhook payloads (Paystack DVA number, Ecobank account number).
  railAccountRef String?       @unique
  createdAt      DateTime      @default(now())
  orders         Order[]
  credits        Credit[]
  ledger         LedgerEntry[]
  reports        Report[]
}

// One order = one expected payment. State machine: PENDING -> PAID, or PENDING -> CANCELLED.
model Order {
  id          String       @id @default(cuid())
  sellerId    String
  seller      Seller       @relation(fields: [sellerId], references: [id])
  amountKobo  Int
  reference   String       @unique // short code the buyer can put in narration, e.g. SG-7K2Q
  note        String?
  state       String       @default("PENDING")
  createdAt   DateTime     @default(now())
  paidAt      DateTime?
  credit      Credit?
  ledgerEntry LedgerEntry?
  reports     Report[]

  @@index([sellerId, state, amountKobo])
}

// One inbound payment as the rail reported it; state MATCHED, HELD (seller picks) or UNMATCHED.
model Credit {
  id         String    @id @default(cuid())
  sellerId   String?
  seller     Seller?   @relation(fields: [sellerId], references: [id])
  rail       String // "paystack" | "ecobank" | "simulated"
  externalId String // the rail's own id for this transaction; (rail, externalId) is the idempotency key
  amountKobo Int
  narration  String?
  payerName  String?
  occurredAt DateTime
  raw        String // full payload as received, for audit
  state      String    @default("UNMATCHED")
  orderId    String?   @unique
  order      Order?    @relation(fields: [orderId], references: [id])
  createdAt  DateTime  @default(now())

  @@unique([rail, externalId])
  @@index([sellerId, state])
}

// One row per confirmed payment. This is the record the seller exports.
model LedgerEntry {
  id         String   @id @default(cuid())
  sellerId   String
  seller     Seller   @relation(fields: [sellerId], references: [id])
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id])
  amountKobo Int
  date       DateTime

  @@index([sellerId, date])
}

// Seller's own record of a fake-alert attempt; never shared with other sellers.
model Report {
  id           String    @id @default(cuid())
  sellerId     String
  seller       Seller    @relation(fields: [sellerId], references: [id])
  orderId      String?
  order        Order?    @relation(fields: [orderId], references: [id])
  note         String?
  imageDataUrl String? // the screenshot the seller was shown, kept only for their own report
  createdAt    DateTime  @default(now())
  sentToBankAt DateTime?
}

// One-time sign-in code. Only a hash is stored; the pending sign-in details ride along until the code is confirmed.
model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  payload   String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}
