<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Only so the Alerts screen can say which supported bank apps are on this phone. Keep in step with BankApps.kt. -->
    <queries>
        <package android:name="team.opay.pay" />
        <package android:name="com.moniepoint.personal" />
        <package android:name="com.moniepoint.business" />
        <package android:name="com.transsnet.palmpay" />
        <package android:name="com.kudabank.app" />
        <package android:name="com.app.ecobank" />
        <package android:name="com.ecobank.mobileapp5" />
        <package android:name="com.ecobankbusiness" />
        <package android:name="com.gtbank.gtworldv1" />
        <package android:name="com.zenithBank.eazymoney" />
        <package android:name="com.accessbank.nextgen" />
        <package android:name="com.accessbank.accessbankapp" />
        <package android:name="com.firstbank.firstmobile" />
        <package android:name="com.wemabank.alat.prod" />
        <package android:name="com.uba.vericash" />
        <package android:name="com.fidelitybank.mobile" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shigo">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reads credit alerts from the bank apps in BankApps.kt only, once the seller allows notification access. -->
        <service
            android:name=".AlertListener"
            android:exported="true"
            android:label="@string/listener_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
